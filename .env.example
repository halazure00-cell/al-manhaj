# Runtime pooled connection (dipakai aplikasi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# Direct/non-pooled connection (khusus Prisma migrate/introspect)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# Gemini API key untuk endpoint backend /api/ai/chat
GEMINI_API_KEY="your_gemini_api_key_here"

# Opsional: model Gemini yang digunakan backend
GEMINI_MODEL="gemini-2.5-pro"

# Opsional (Vercel build)
RUN_PRISMA_MIGRATIONS="false"
PRISMA_MIGRATE_TIMEOUT_MS="60000"
PRISMA_MIGRATIONS_REQUIRED="false"
