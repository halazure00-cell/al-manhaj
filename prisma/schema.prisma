generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum ChatRole {
  USER
  AI
}

enum AiCoachMode {
  CHAT
  PLAN
  REVIEW
}

enum FeedbackRating {
  UP
  DOWN
}

// Epic 1: Curriculum Tracking
model Book {
  id         String     @id @default(uuid())
  title      String
  author     String
  category   String   // e.g., "Theology", "Logic", "History", "Fiqh"
  addedAt    DateTime   @default(now()) // Explicit date when the book is added to the curriculum
  source     String?    // Optional acquisition source
  initialNote String?   @db.Text // Optional initial context about the book
  stageLevel Int      // Roadmap progression stage (1-4)
  totalPages Int
  readPages  Int        @default(0)
  status     BookStatus @default(NOT_STARTED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  notes      Note[]
}

// Epic 2: Networked Notes (Zettelkasten)
model Note {
  id        String   @id @default(uuid())
  bookId    String?  // Nullable if the note is a synthesis of multiple books
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bi-directional Relations for Knowledge Graph
  sourceLinks NoteLink[] @relation("SourceNote")
  targetLinks NoteLink[] @relation("TargetNote")
  chunks      NoteChunk[]
}

model NoteLink {
  id           String   @id @default(uuid())
  sourceNoteId String
  targetNoteId String
  createdAt    DateTime @default(now())

  sourceNote Note @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId]) // Prevent duplicate links between the exact same notes
}

model NoteChunk {
  id         String   @id @default(uuid())
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  chunkIndex Int
  heading    String?
  content    String   @db.Text
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([noteId, chunkIndex])
}

model ChatSession {
  id           String        @id @default(uuid())
  title        String?
  summary      String?       @db.Text
  deviceKey    String?
  lastMode     AiCoachMode   @default(CHAT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]

  @@index([updatedAt])
}

model ChatMessage {
  id            String       @id @default(uuid())
  sessionId     String
  session       ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String       @db.Text
  retrievalMeta Json?
  mode          AiCoachMode  @default(CHAT)
  createdAt     DateTime     @default(now())
  feedback      AiFeedback?

  @@index([sessionId, createdAt])
}

model AiFeedback {
  id        String         @id @default(uuid())
  messageId String         @unique
  message   ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  rating    FeedbackRating
  reason    String?        @db.Text
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

// Epic 3: Habit Tracker
model Habit {
  id          String         @id @default(uuid())
  title       String
  description String?
  frequency   HabitFrequency @default(DAILY)
  createdAt   DateTime       @default(now())
  logs        HabitLog[]
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  logDate     DateTime @db.Date
  isCompleted Boolean  @default(false)
  evaluation  String?  @db.Text // Daily reflection/notes

  @@unique([habitId, logDate]) // Ensure only one log per habit per day
}
